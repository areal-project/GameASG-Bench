{
  "version": "2.0-contract-only",
  "_doc": "Park Master L1 public TDD contract checks",
  "_source": "task/park-master/tdd.md",
  "_scope": "L1 checks only the TDD-defined public __gameTest contract, player-level action schemas, legal scenario names, snapshot envelope, and rejection guards. Gameplay behavior, source structure, and internal implementation are covered by checks.js.",
  "tool_checks": [
    {
      "id": "p0-html-runtime-shell",
      "level": "P0",
      "name": "HTML document includes a runtime shell",
      "type": "tool_check",
      "tool": "html_structure",
      "required_tags": [
        "html",
        "body",
        "script"
      ],
      "fix_hint": "Provide an HTML game entry with executable JavaScript."
    },
    {
      "id": "p0-javascript-syntax",
      "level": "P0",
      "name": "Inline and local JavaScript parses",
      "type": "tool_check",
      "tool": "node_syntax",
      "fix_hint": "Fix JavaScript syntax errors in inline or local linked scripts."
    },
    {
      "id": "p0-playable-script-not-empty",
      "level": "P0",
      "name": "Implementation script is not an empty shell",
      "type": "tool_check",
      "tool": "script_not_empty",
      "min_length": 4000,
      "fix_hint": "Implement the TDD public contract and playable behavior in executable script."
    }
  ],
  "checks": [
    {
      "id": "p0-public-contract-object",
      "level": "P0",
      "name": "TDD public contract object is assigned",
      "type": "regex_any",
      "patterns": [
        "(?:window|globalThis|self)\\s*(?:\\.\\s*__gameTest|\\[\\s*[\"']__gameTest[\"']\\s*\\])\\s*=",
        "Object\\.assign\\s*\\(\\s*(?:window|globalThis|self)\\s*,\\s*\\{[\\s\\S]{0,900}__gameTest\\s*:"
      ],
      "fix_hint": "Expose the TDD-defined public contract object as window.__gameTest."
    },
    {
      "id": "p0-public-contract-methods",
      "level": "P0",
      "name": "Public adapter exposes reset, loadScenario, input, and getSnapshot",
      "type": "regex_all",
      "patterns": [
